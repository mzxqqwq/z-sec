#!/usr/bin/env python3
"""
ctf_orchestrator.py —— CTF 编排器 v2（M1：并行 + 题型模型路由 + 同题多模型竞速）

黑板模型（对齐 Cairn）：
- Fact   = state.json 每题状态 + 每次尝试审计
- Intent = 每道 status=open 的题
- Hint   = hints/<cid>.md，人工写入自动注入下一轮

调度：
- 多道题并行（--max-parallel-challenges）
- 每道题可派多个不同模型的 worker 竞速（--race-workers），先出 flag 者胜
- 模型/思考档位按题型路由（--model-config JSON）

用法：
  python ctf_orchestrator.py --once --workspace D:/ctf-agent/workspace
  python ctf_orchestrator.py --loop 120
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Optional

import requests

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "dasctf_client"))
from dasctf_client import DasctfClient, extract_flags  # noqa: E402

# Windows 控制台默认 GBK，emoji/特殊字符会导致 UnicodeEncodeError 崩溃。
try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass

KALI_API = os.environ.get("KALI_API_URL", "http://10.174.153.128:5000")
WORKER_TIMEOUT = 1500  # 单个 worker 上限 25 分钟

DEFAULT_PI_CMD = [
    "powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
    r"D:\ctf-agent\src\run-pi.ps1",
]

DEFAULT_MODEL_CONFIG = {
    "category_routing": {
        "web":    [{"model": "deepseek-v4-pro",   "thinking": "high"}],
        "pwn":    [{"model": "deepseek-v4-pro",   "thinking": "high"},
                   {"model": "deepseek-v4-flash", "thinking": "low"}],
        "crypto": [{"model": "deepseek-v4-flash", "thinking": "medium"}],
        "rev":    [{"model": "deepseek-v4-pro",   "thinking": "medium"}],
        "misc":   [{"model": "deepseek-v4-flash", "thinking": "low"}],
        "default":[{"model": "deepseek-v4-flash", "thinking": "low"}],
    },
    "max_parallel_challenges": 3,
    "race_workers_per_challenge": 2,
}

SOLVE_PROMPT_TEMPLATE = """\
你是一名 CTF 选手，正在参加 DASCTF 竞赛。请独立解出下面这道题并给出 flag。

题目信息：
{challenge_json}

附件已下载到工作目录 attachments/（如无附件则忽略）。

工作环境说明：你的 bash/文件工具实际运行在一台装好 pwntools/angr/z3/sympy/
nmap/sqlmap/binwalk/john/hashcat/radare2 的 Kali Linux 上（远程）。
你可以自由地写脚本、运行工具、连网络服务。解题成功后，用
"FLAG: <flag内容>" 一行输出最终答案。

{human_hints}
"""


def kali_exec(command: str, timeout: int = 300) -> dict[str, Any]:
    resp = requests.post(f"{KALI_API}/api/command", json={"command": command}, timeout=timeout)
    resp.raise_for_status()
    return resp.json()


def kali_upload(local_dir: Path, remote_dir: str) -> None:
    if not local_dir.exists():
        return
    files = [f for f in local_dir.iterdir() if f.is_file()]
    if not files:
        return
    kali_exec(f"mkdir -p {remote_dir}")
    for f in files:
        b64 = base64.b64encode(f.read_bytes()).decode()
        name = f.name.replace("'", r"'\''")
        kali_exec(f"echo '{b64}' | base64 -d > {remote_dir}/{name}")


@dataclass
class ChallengeState:
    cid: str
    raw: dict[str, Any]
    status: str = "open"
    attempts: list[dict[str, Any]] = field(default_factory=list)
    wrong_submits: int = 0

    def to_dict(self) -> dict[str, Any]:
        return {"cid": self.cid, "raw": self.raw, "status": self.status,
                "attempts": self.attempts, "wrong_submits": self.wrong_submits}


class Orchestrator:
    def __init__(self, workspace: Path, client: DasctfClient, pi_cmd: list[str],
                 model_config: dict[str, Any],
                 max_attempts_per_challenge: int = 2, max_wrong_submits: int = 3) -> None:
        self.ws = workspace
        self.ws.mkdir(parents=True, exist_ok=True)
        (self.ws / "hints").mkdir(parents=True, exist_ok=True)
        (self.ws / "challenges").mkdir(parents=True, exist_ok=True)
        self.client = client
        self.pi_cmd = pi_cmd
        self.model_config = model_config
        self.max_attempts = max_attempts_per_challenge
        self.max_wrong_submits = max_wrong_submits
        self.state_file = workspace / "state.json"
        self.challenges: dict[str, ChallengeState] = {}
        self._submit_lock = threading.Lock()
        self._load()

    # ---------- 黑板 ----------
    def _load(self) -> None:
        if self.state_file.exists():
            data = json.loads(self.state_file.read_text(encoding="utf-8"))
            for item in data.get("challenges", []):
                cs = ChallengeState(item["cid"], item["raw"], item["status"],
                                    item["attempts"], item["wrong_submits"])
                self.challenges[cs.cid] = cs

    def _save(self) -> None:
        self.state_file.write_text(
            json.dumps({"challenges": [c.to_dict() for c in self.challenges.values()]},
                       ensure_ascii=False, indent=2),
            encoding="utf-8")

    def sync(self) -> int:
        new_count = 0
        for raw in self.client.challenges():
            cid = str(raw.get("id") or raw.get("challenge_id") or raw.get("name", ""))
            if not cid:
                continue
            if cid not in self.challenges:
                self.challenges[cid] = ChallengeState(cid, raw)
                new_count += 1
        self._save()
        return new_count

    def hints(self, cid: str) -> str:
        hint_file = self.ws / "hints" / f"{cid}.md"
        if hint_file.exists():
            return "\n\n【人工提示（最新优先）】\n" + hint_file.read_text(encoding="utf-8")
        return ""

    # ---------- 模型路由 ----------
    def worker_configs(self, cid: str) -> list[dict[str, str]]:
        cat = (self.challenges[cid].raw.get("category") or "default").lower()
        routing = self.model_config.get("category_routing", {})
        configs = routing.get(cat) or routing.get("default") or [{"model": "deepseek-v4-flash", "thinking": "low"}]
        race = int(self.model_config.get("race_workers_per_challenge", 1))
        return configs[:max(1, race)]

    # ---------- 交卷 ----------
    def submit_flag(self, cid: str, flag: str) -> bool:
        with self._submit_lock:
            cs = self.challenges[cid]
            if cs.wrong_submits >= self.max_wrong_submits:
                return False
            try:
                res = self.client.submit(cid, flag)
            except Exception as e:
                print(f"[{cid}] submit failed: {e}")
                return False
            if res.get("correct") in (True, "true", 1) or res.get("success") in (True, "true", 1):
                cs.status = "solved"
                self._save()
                print(f"[{cid}] [SOLVED] {flag[:32]}...")
                return True
            cs.wrong_submits += 1
            self._save()
            print(f"[{cid}] wrong flag (budget {cs.wrong_submits}/{self.max_wrong_submits})")
            return False

    # ---------- 单题竞速 ----------
    def run_one(self, cid: str) -> None:
        cs = self.challenges[cid]
        if cs.status != "open":
            return
        if len(cs.attempts) >= self.max_attempts:
            cs.status = "dead"
            self._save()
            print(f"[{cid}] attempts exhausted -> dead")
            return

        cs.status = "solving"
        self._save()

        workdir = self.ws / "challenges" / cid
        workdir.mkdir(parents=True, exist_ok=True)
        att_dir = workdir / "attachments"
        att_dir.mkdir(exist_ok=True)
        try:
            self.client.download_attachment(cid, att_dir)
        except Exception as e:
            print(f"[{cid}] attachment download failed: {e}")

        remote_root = f"/root/ctf/{cid}"
        try:
            kali_exec(f"mkdir -p {remote_root}/attachments")
            kali_upload(att_dir, f"{remote_root}/attachments")
        except Exception as e:
            print(f"[{cid}] kali sync failed: {e}")

        prompt = SOLVE_PROMPT_TEMPLATE.format(
            challenge_json=json.dumps(cs.raw, ensure_ascii=False, indent=2),
            human_hints=self.hints(cid))

        configs = self.worker_configs(cid)
        print(f"[{cid}] race: {len(configs)} workers "
              + ", ".join(f"{c['model']}:{c['thinking']}" for c in configs))

        procs: dict[subprocess.Popen, dict[str, str]] = {}
        starts: dict[subprocess.Popen, float] = {}
        for i, cfg in enumerate(configs):
            tag = f"{cfg['model']}:{cfg['thinking']}".replace("/", "_").replace(":", "-")
            out_path = workdir / f"worker_{i}_{tag}.log"
            cmd = (self.pi_cmd + ["--model", cfg["model"], "--thinking", cfg["thinking"],
                                  "--kali", remote_root, "-p", prompt])
            with open(out_path, "w", encoding="utf-8") as fh:
                proc = subprocess.Popen(cmd, cwd=str(workdir), stdout=fh, stderr=subprocess.STDOUT)
            procs[proc] = {**cfg, "log": str(out_path)}
            starts[proc] = time.time()
            print(f"[{cid}] worker {i} started: {tag} (pid {proc.pid})")

        solved = False
        deadline = time.time() + WORKER_TIMEOUT
        while procs and not solved and time.time() < deadline:
            finished = [p for p in procs if p.poll() is not None]
            for p in finished:
                meta = procs.pop(p)
                elapsed = time.time() - starts.get(p, time.time())
                out_text = ""
                if Path(meta["log"]).exists():
                    out_text = Path(meta["log"]).read_text(encoding="utf-8", errors="replace")
                flags = extract_flags(out_text)
                cs.attempts.append({"at": time.time(), "elapsed": elapsed,
                                    "worker": f"{meta['model']}:{meta['thinking']}",
                                    "output_tail": out_text[-4000:], "flags": flags})
                self._save()
                print(f"[{cid}] worker {meta['model']} done in {elapsed:.0f}s, flags={flags[:3]}")
                if flags:
                    for flag in flags[:3]:
                        if cs.wrong_submits >= self.max_wrong_submits:
                            break
                        if self.submit_flag(cid, flag):
                            solved = True
                            break
                if solved:
                    break
            time.sleep(2)

        if solved:
            for p in procs:
                p.terminate()
            time.sleep(2)
            for p in procs:
                if p.poll() is None:
                    p.kill()
            print(f"[{cid}] race won; other workers terminated")
        else:
            print(f"[{cid}] race finished unsolved (timeout or all workers done)")
        if cs.status == "solving":
            cs.status = "open"
            self._save()

    # ---------- 轮次 ----------
    def run_round(self) -> None:
        n = self.sync()
        print(f"round: {len(self.challenges)} challenges known ({n} new)")
        open_cids = [cid for cid, cs in self.challenges.items() if cs.status == "open"]
        max_par = int(self.model_config.get("max_parallel_challenges", 3))
        with ThreadPoolExecutor(max_workers=max_par) as pool:
            list(pool.map(self.run_one, open_cids))
        self._save()

    def loop(self, interval: int) -> None:
        while True:
            try:
                self.run_round()
            except Exception as e:
                print(f"round error: {e}")
            time.sleep(interval)


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="ctf_orchestrator")
    p.add_argument("--workspace", default="D:/ctf-agent/workspace")
    p.add_argument("--once", action="store_true")
    p.add_argument("--loop", type=int, default=0, metavar="SECONDS")
    p.add_argument("--pi-cmd", default=None)
    p.add_argument("--model-config", default=None, help="path to model routing json")
    args = p.parse_args(argv)

    client = DasctfClient(os.environ.get("DASCTF_BASE_URL", "https://game.gcsis.cn"))
    username = os.environ.get("DASCTF_USERNAME", "")
    password = os.environ.get("DASCTF_PASSWORD", "")
    if username and password:
        try:
            client.login(username, password)
        except Exception as e:
            print(f"login failed: {e}")

    pi_cmd = json.loads(args.pi_cmd) if args.pi_cmd else DEFAULT_PI_CMD
    model_config = DEFAULT_MODEL_CONFIG
    if args.model_config and Path(args.model_config).exists():
        model_config = json.loads(Path(args.model_config).read_text(encoding="utf-8"))

    orch = Orchestrator(Path(args.workspace), client, pi_cmd, model_config)
    if args.loop > 0:
        orch.loop(args.loop)
    else:
        orch.run_round()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
